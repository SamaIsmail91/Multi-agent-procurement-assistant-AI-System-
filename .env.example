# -----------------------------------------------------------------------
# Copy this file to `.env` and fill in the keys you have. See README.md
# "Getting API Keys" for where to get each one and free-tier notes.
# -----------------------------------------------------------------------

# --- LLM provider (choose ONE provider, uncomment its block) --------------
# CrewAI 1.x uses native SDKs for these -- no litellm install needed for any
# of them, including Ollama and DashScope (hosted Qwen).

# --- Option A: Anthropic / Claude (default, paid, no free tier) -----------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MANAGER_MODEL=anthropic/claude-sonnet-4-6
WORKER_MODEL=anthropic/claude-sonnet-4-6

# --- Option B: OpenAI -------------------------------------------------------
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# MANAGER_MODEL=openai/gpt-4o
# WORKER_MODEL=openai/gpt-4o-mini

# --- Option C: Groq (fast, has a free tier) ---------------------------------
# Needs `pip install "crewai[litellm]"` too -- unlike the other options here,
# Groq isn't one of crewai's native/OpenAI-compatible providers.
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# MANAGER_MODEL=groq/llama-3.3-70b-versatile
# WORKER_MODEL=groq/llama-3.3-70b-versatile

# --- Option D: Local Ollama -- FREE, private, no API key, no signup --------
# Needs the Ollama app installed & running separately (ollama.com), plus a
# model pulled first, e.g.: ollama pull qwen2.5:14b
# Use 'ollama_chat/<model>' (not 'ollama/<model>') for reliable tool calling.
# LLM_PROVIDER=ollama
# MANAGER_MODEL=ollama_chat/qwen2.5:14b
# WORKER_MODEL=ollama_chat/qwen2.5:14b
# OLLAMA_BASE_URL=http://localhost:11434
# Note: smaller/quantized local models are noticeably less reliable at
# strict JSON + tool-calling than Claude/GPT -- expect more guardrail
# retries. 14B+ parameter models work best; try qwen2.5:32b if you have the
# VRAM/RAM for it.

# --- Option E: Qwen via Alibaba Cloud DashScope (hosted, has a free tier) --
# LLM_PROVIDER=dashscope
# DASHSCOPE_API_KEY=
# MANAGER_MODEL=dashscope/qwen-plus
# WORKER_MODEL=dashscope/qwen-turbo

# --- Tools ----------------------------------------------------------------
TAVILY_API_KEY=
SCRAPEGRAPH_API_KEY=

# --- Behaviour --------------------------------------------------------------
CREW_PROCESS=sequential          # sequential | hierarchical
# Off by default: pulls in chromadb + a local embedder for cross-run recall.
# Verified during development that this can trigger a hard process abort at
# shutdown in some containerized environments. Flip to true once you've
# confirmed it behaves cleanly where you're deploying this. See README
# "Design notes / limitations".
CREW_MEMORY=false
CREW_VERBOSE=true
MAX_PRODUCTS_PER_SOURCE=5
MAX_SOURCES=4
CACHE_TTL_HOURS=24
